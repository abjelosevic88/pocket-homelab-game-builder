[Unit]
Description=Pocket Game Builder — your 3D printers in one place
After=network-online.target
Wants=network-online.target

[Service]
User=pocket-gamebuilder
Group=pocket-gamebuilder
ExecStart=/usr/local/bin/pocket-gamebuilder
Environment=DATA_DIR=/var/lib/pocket-gamebuilder
Environment=PORT=8080
Environment=BASE_URL=https://gamebuilder.example.com
Environment=SECURE_COOKIES=true
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pocket-gamebuilder
PrivateTmp=true

[Install]
WantedBy=multi-user.target
